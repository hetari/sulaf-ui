{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "dev": { "dependsOn": ["@sulaf/registry#build"], "cache": false, "persistent": true }
  }
}
