{
  "name": "sulaf-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sulaf/docs dev",
    "docs:dev": "pnpm --filter @sulaf/docs dev",
    "docs:build": "pnpm --filter @sulaf/docs build",
    "docs:generate": "pnpm --filter @sulaf/docs generate",
    "docs:preview": "pnpm --filter @sulaf/docs preview",
    "docs:start": "pnpm --filter @sulaf/docs start",
    "docs:prepare": "pnpm --filter @sulaf/docs exec nuxi prepare",
    "docs:typecheck": "pnpm --filter @sulaf/docs typecheck",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck && pnpm fmt:check && pnpm lint",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "ui:add": "pnpm --filter @sulaf/ui ui:add",
    "ui:sync": "pnpm --filter @sulaf/ui ui:sync",
    "new:component": "pnpm --filter @sulaf/registry new",
    "e2e": "tsx e2e/run.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=sulaf && changeset publish",
    "fix": "pnpm fmt && pnpm lint:fix",
    "postinstall": "pnpm dlx husky install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "nano-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.14.0"
}
